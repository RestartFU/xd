  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Neutral filled action.",
      "html": "<button class=\"ds-primary\">New session</button>",
      "css": ".ds-primary{font:500 12px Inter,sans-serif;cursor:pointer;height:30px;padding:0 12px;border:0;border-radius:6px;background:#dedede;color:#1b1b1b}.ds-primary:hover{background:#f2f2f2}.ds-primary:focus-visible{outline:2px solid #858585;outline-offset:2px}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Tonal secondary action.",
      "html": "<button class=\"ds-secondary\">Continue</button>",
      "css": ".ds-secondary{font:500 12px Inter,sans-serif;cursor:pointer;height:30px;padding:0 12px;border:1px solid #383838;border-radius:6px;background:#292929;color:#f1f1f1}.ds-secondary:hover{background:#333333}.ds-secondary:focus-visible{outline:2px solid #858585;outline-offset:2px}"
    },
    {
      "name": "Ghost button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Quiet chrome control.",
      "html": "<button class=\"ds-ghost\">Settings</button>",
      "css": ".ds-ghost{font:500 12px Inter,sans-serif;cursor:pointer;height:30px;padding:0 12px;border:0;border-radius:6px;background:transparent;color:#b1b1b1}.ds-ghost:hover{background:#333333;color:#f1f1f1}.ds-ghost:focus-visible{outline:2px solid #858585}"
    },
    {
      "name": "Chat tabs",
      "kind": "nav",
      "refersTo": "chat-tab",
      "description": "Independent conversations within a workspace.",
      "html": "<div class=\"ds-tabs\"><button class=\"ds-tab is-active\">Implementation</button><button class=\"ds-tab\">Review</button></div>",
      "css": ".ds-tabs{display:flex;gap:4px;padding:6px;background:#292929d9}.ds-tab{font:500 12px Inter,sans-serif;cursor:pointer;height:30px;padding:0 10px;border:1px solid transparent;border-radius:7px;background:transparent;color:#b1b1b1}.ds-tab.is-active{border-color:#383838;background:#373737;color:#f1f1f1}.ds-tab:hover{background:#333333}.ds-tab:focus-visible{outline:2px solid #858585}"
    },
    {
      "name": "Composer",
      "kind": "input",
      "refersTo": "composer",
      "description": "A clear editing surface with stable text contrast.",
      "html": "<label class=\"ds-composer\"><textarea placeholder=\"Ask anything, or describe a task…\"></textarea></label>",
      "css": ".ds-composer{display:block;padding:12px;border:1px solid #383838;border-radius:16px;background:#303030e8}.ds-composer textarea{width:100%;min-height:64px;resize:vertical;border:0;background:transparent;color:#f1f1f1;font:400 14px Inter,sans-serif}.ds-composer textarea::placeholder{color:#b1b1b1}.ds-composer:focus-within{border-color:#858585}.ds-composer textarea:focus{outline:0}"
    },
    {
      "name": "Status",
      "kind": "chip",
      "description": "Status uses text together with its signal color.",
      "html": "<span class=\"ds-status\">Working</span>",
      "css": ".ds-status{display:inline-flex;align-items:center;gap:6px;font:500 12px Inter,sans-serif;color:#8dceb0}.ds-status:before{content:\"\";width:6px;height:6px;border-radius:50%;background:currentColor}"
    },
    {
      "name": "Session row",
      "kind": "card",
      "description": "One row per session, restoring its selected chat.",
      "html": "<button class=\"ds-session\">Workspace navigation</button>",
      "css": ".ds-session{font:500 12px Inter,sans-serif;cursor:pointer;height:30px;width:240px;padding:0 10px;text-align:left;border:0;border-radius:6px;background:#373737;color:#f1f1f1}.ds-session:hover{background:#333333}.ds-session:focus-visible{outline:2px solid #858585}"
    }
  ],
  "narrative": {
    "northStar": "A Clear Workspace",
    "overview": "xd uses neutral charcoal and clear glass to frame a generous conversation area. Projects contain sessions; each session contains separate chat tabs sharing one workspace. The sidebar stays compact, chat controls sit beside the conversation, and workspace tools remain available alongside it.\n\nDark uses charcoal surfaces and silver actions. Light uses neutral silver chrome and white reading surfaces. Desktop translucency belongs to chrome and the composer; text, code and tool output keep a stable reading background. Android carries the same palette and hierarchy through native Material 3 layouts.",
    "keyCharacteristics": [
      "Two themes: Dark and Light. Retired saved names load as Dark.",
      "Inter for prose and controls; JetBrains Mono for code and terminal text.",
      "Separate chat tabs share a session workspace and terminal.",
      "Real platform window controls; no decorative traffic lights.",
      "Neutral selection and focus, with color reserved for meaningful status."
    ],
    "rules": [],
    "dos": [
      "Do use semantic ThemeColors or Material color roles in both themes.",
      "Do center the empty-state context and heading over the composer, allowing natural text height.",
      "Do preserve independent chat histories, drafts and agent settings when switching tabs.",
      "Do retain native window, keyboard, touch and system inset behavior.",
      "Do keep opaque reading surfaces beneath prose, code and terminal output."
    ],
    "donts": [
      "Don't restore the retired red rules, bone palette or card-catalog metaphor.",
      "Don't make closing a chat tab delete its conversation.",
      "Don't use fake Mac window controls on other platforms.",
      "Don't depend on translucency or color alone to identify selection or status.",
      "Don't scale desktop layouts into phone thumbnails; use native responsive structure."
    ]
  }
}
