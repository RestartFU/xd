  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Bone fill with ink text; one per region, e.g. New session.",
      "html": "<button class=\"ds-btn-primary\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M12 5v14M5 12h14\"/></svg>New session</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;gap:8px;height:30px;padding:0 12px;border:none;border-radius:6px;background:#e8e5de;color:#121314;font:500 12.5px 'Libre Franklin',sans-serif;cursor:pointer}.ds-btn-primary:hover{background:#ffffff}.ds-btn-primary:focus-visible{outline:2px solid #93b5e9;outline-offset:2px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Card stock with a seam border.",
      "html": "<button class=\"ds-btn-secondary\">Continue</button>",
      "css": ".ds-btn-secondary{height:30px;padding:0 12px;border:1px solid #313338;border-radius:6px;background:#1e1f22;color:#eceae5;font:500 12.5px 'Libre Franklin',sans-serif;cursor:pointer}.ds-btn-secondary:hover{background:#27292c}.ds-btn-secondary:focus-visible{outline:2px solid #93b5e9;outline-offset:2px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Quiet footer and toolbar action; pulled-card fill while its panel is open.",
      "html": "<button class=\"ds-btn-ghost\">Settings</button><button class=\"ds-btn-ghost is-active\">Settings</button>",
      "css": ".ds-btn-ghost{height:30px;padding:0 12px;border:none;border-radius:6px;background:transparent;color:#aaa9a3;font:500 12.5px 'Libre Franklin',sans-serif;cursor:pointer;margin-right:6px}.ds-btn-ghost:hover{background:#27292c;color:#eceae5}.ds-btn-ghost.is-active{background:#2b2d31;color:#eceae5}.ds-btn-ghost:focus-visible{outline:2px solid #93b5e9;outline-offset:2px}"
    },
    {
      "name": "Danger Button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Destructive action outlined in danger red.",
      "html": "<button class=\"ds-btn-danger\">Delete</button>",
      "css": ".ds-btn-danger{height:30px;padding:0 12px;border:1px solid #ec7064;border-radius:6px;background:transparent;color:#ec7064;font:500 12.5px 'Libre Franklin',sans-serif;cursor:pointer}.ds-btn-danger:hover{background:#3b201e}.ds-btn-danger:focus-visible{outline:2px solid #93b5e9;outline-offset:2px}"
    },
    {
      "name": "Find Field",
      "kind": "input",
      "refersTo": "find-field",
      "description": "Catalog filter; no keyboard shortcut so terminals keep Ctrl-K. Esc clears.",
      "html": "<label class=\"ds-find\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#8b8a85\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14ZM20 20l-4-4\"/></svg><input placeholder=\"Find a session or project\"></label>",
      "css": ".ds-find{display:flex;align-items:center;gap:8px;width:268px;height:32px;padding:0 8px;border:1px solid #313338;border-radius:6px;background:#121314}.ds-find input{flex:1;min-width:0;border:none;background:transparent;color:#eceae5;font:400 12.5px 'Libre Franklin',sans-serif;outline:none;caret-color:#93b5e9}.ds-find input::placeholder{color:#8b8a85}.ds-find:focus-within{border-color:#93b5e9}"
    },
    {
      "name": "Session Card with Signal Tabs",
      "kind": "card",
      "refersTo": "session-card",
      "description": "Fixed 56px index card: title, ruled red line, metadata; the clipped tab's shape and hue give state.",
      "html": "<div class=\"ds-drawer\"><div class=\"ds-card\"><div class=\"ds-card-title\">Fix idle status on multi-tab</div><div class=\"ds-rule\"></div><div class=\"ds-meta\">master <span class=\"ds-dot\">·</span> Idle</div></div><div class=\"ds-card\"><span class=\"ds-tab ds-tab-working\"></span><div class=\"ds-card-title\">Windows WSL host deploy</div><div class=\"ds-rule\"></div><div class=\"ds-meta\">master <span class=\"ds-dot\">·</span> <b style=\"color:#72b783\">Working</b></div></div><div class=\"ds-card\"><span class=\"ds-tab ds-tab-waiting\"></span><div class=\"ds-card-title\">Pairing code expiry</div><div class=\"ds-rule\"></div><div class=\"ds-meta\">master <span class=\"ds-dot\">·</span> <b style=\"color:#eaa93a\">Waiting on you</b></div></div><div class=\"ds-card is-selected\"><span class=\"ds-tab ds-tab-done\"></span><div class=\"ds-card-title\">Release v0.1.21</div><div class=\"ds-rule\"></div><div class=\"ds-meta\">master <span class=\"ds-dot\">·</span> <b style=\"color:#86a9e4\">Done</b></div></div></div>",
      "css": ".ds-drawer{width:264px;padding:5px;border:1px solid #313338;border-radius:8px;background:#121314;display:flex;flex-direction:column;gap:10px;padding-top:12px}.ds-card{position:relative;height:56px;padding:0 12px;border:1px solid transparent;border-radius:5px;background:#1e1f22;cursor:pointer;font-family:'Libre Franklin',sans-serif}.ds-card:hover{background:#27292c}.ds-card.is-selected{background:#2b2d31;border-color:#e8e5de}.ds-card-title{padding:8px 26px 0 0;height:28px;box-sizing:border-box;font-size:13px;font-weight:500;color:#eceae5;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ds-rule{height:1px;background:#a8493c}.ds-meta{height:25px;display:flex;align-items:center;gap:6px;font-size:11.5px;color:#aaa9a3}.ds-meta b{font-weight:500}.ds-dot{color:#8b8a85}.ds-tab{position:absolute;right:12px;width:16px;border-radius:2px 2px 0 0}.ds-tab-working{top:-4px;height:9px;background:#72b783}.ds-tab-waiting{top:-7px;height:12px;background:#eaa93a}.ds-tab-done{top:-4px;height:9px;box-sizing:border-box;border:1.5px solid #86a9e4;border-bottom:0;background:#121314}"
    },
    {
      "name": "Closed Drawer Row",
      "kind": "nav",
      "refersTo": "drawer-closed",
      "description": "One 34px line per project with mono count and miniature signal tabs.",
      "html": "<div class=\"ds-drawer-row\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#8b8a85\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m9 6 6 6-6 6\"/></svg><span class=\"ds-name\">Lunar</span><span class=\"ds-count\">3</span><span class=\"ds-grow\"></span><span class=\"ds-mini\"><i style=\"height:5px;background:#72b783\"></i><i style=\"height:8px;background:#eaa93a\"></i><i style=\"height:5px;box-sizing:border-box;border:1px solid #86a9e4\"></i></span></div>",
      "css": ".ds-drawer-row{width:270px;height:34px;padding:0 4px;display:flex;align-items:center;gap:8px;border-radius:5px;background:#17181a;cursor:pointer;font-family:'Libre Franklin',sans-serif}.ds-drawer-row:hover{background:#27292c}.ds-name{font-size:13px;font-weight:500;color:#eceae5}.ds-count{font:400 11px 'JetBrains Mono',monospace;color:#8b8a85}.ds-grow{flex:1}.ds-mini{display:flex;align-items:flex-end;gap:3px}.ds-mini i{display:block;width:10px;border-radius:1px}"
    },
    {
      "name": "Label Frame",
      "kind": "chip",
      "refersTo": "label-frame",
      "description": "The current project's name in an outlined drawer label.",
      "html": "<span class=\"ds-label-frame\">xd</span>",
      "css": ".ds-label-frame{display:inline-flex;align-items:center;height:22px;padding:0 7px;border:1.5px solid #e8e5de;border-radius:3px;font:600 13px 'Libre Franklin',sans-serif;color:#eceae5}"
    },
    {
      "name": "Stamp",
      "kind": "chip",
      "refersTo": "stamp",
      "description": "Uppercase rubber-stamp status: session state, Waiting on you, or a failed tool run.",
      "html": "<span class=\"ds-stamp\" style=\"color:#72b783\">Working</span> <span class=\"ds-stamp\" style=\"color:#eaa93a\">Waiting on you</span> <span class=\"ds-stamp\" style=\"color:#ec7064\">Failed</span>",
      "css": ".ds-stamp{display:inline-flex;align-items:center;height:18px;padding:0 5px;border:1px solid currentColor;border-radius:2px;font:600 10px 'Libre Franklin',sans-serif;text-transform:uppercase}"
    },
    {
      "name": "Pane Segmented Control",
      "kind": "nav",
