    "typographyMeta": {
      "display": {
        "displayName": "Display",
        "purpose": "Project name on the project home, inside its label frame. Markdown H1 is 22px Bold, H2 19px, H3 16px."
      },
      "headline": {
        "displayName": "Headline",
        "purpose": "Session title in the 52px session header."
      },
      "title": {
        "displayName": "Title",
        "purpose": "Card titles (500), drawer names (500 closed, 600 current), catalog header, popover rows."
      },
      "body": {
        "displayName": "Body",
        "purpose": "Chat transcript messages; column capped at 860px."
      },
      "body-ui": {
        "displayName": "Body UI",
        "purpose": "Buttons (500), Find, empty states, hints."
      },
      "label": {
        "displayName": "Label",
        "purpose": "Card metadata, message role labels and settings group labels (600, faint, sentence case)."
      },
      "stamp": {
        "displayName": "Stamp",
        "purpose": "Uppercase rubber-stamp status frame; never a section heading."
      },
      "mono": {
        "displayName": "Mono",
        "purpose": "Code, tool output, terminal, branch names in lists, counts (11px). Never prose or chrome."
      }
    },
