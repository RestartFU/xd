<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" RequiredVersion="6.0.0">
  <Package
    Name="$(ProductName)"
    Manufacturer="RestartFU"
    Version="$(Version)"
    UpgradeCode="$(UpgradeCode)"
    Scope="perMachine"
    Language="1033">

    <MajorUpgrade
      AllowSameVersionUpgrades="yes"
      DowngradeErrorMessage="A newer version of $(ProductName) is already installed." />
    <MediaTemplate
      EmbedCab="no"
      CabinetTemplate="xd{0}.cab"
      CompressionLevel="high"
      MaximumUncompressedMediaSize="2048" />
    <Icon Id="xd.ico" SourceFile="$(IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="xd.ico" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="ManufacturerFolder" Name="RestartFU">
        <Directory Id="INSTALLFOLDER" Name="$(InstallName)">
          <Files Include="$(Payload)\**" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="$(ProductName)">
        <Component Id="ApplicationShortcut" Guid="$(ShortcutGuid)">
          <Shortcut
            Id="StartMenuShortcut"
            Name="$(ProductName)"
            Description="Workspace-organized AI conversations"
            Target="[INSTALLFOLDER]bin\xd.exe"
            Icon="xd.ico"
            WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
          <RegistryValue
            Root="HKLM"
            Key="Software\RestartFU\$(InstallName)"
            Name="Installed"
            Type="integer"
            Value="1"
            KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
  </Package>
</Wix>
