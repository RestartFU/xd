<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The window shows for the frames before Compose paints, so it wears a
      theme's backdrop. The saved theme cannot be read that early, so the
      system's night mode picks which: Light's here, Dark's in values-night.
      The colours are the backdrops in ui/Theme.kt, and a test keeps them equal.
      The status bar is clear over that ground, with icons that read on it.
    -->
    <style name="Theme.Xd" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/xd_ground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/xd_ground_is_light</item>
    </style>
    <color name="xd_ground">#E4E7F4</color>
    <bool name="xd_ground_is_light">true</bool>
</resources>
