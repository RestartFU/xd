[Unit]
Description=@APP_NAME@ daemon
Documentation=https://github.com/RestartFU/xd

# A daemon that died mid-turn should come back. A daemon that refuses to start
# because another one already holds the socket should not: a window that
# started its own daemon owns it until it quits, and retrying until then would
# only fill the journal.
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
# The daemon owns the database, the workspace tree and the agent processes;
# the window is only one of its clients. Running it under the user manager
# rather than under the window is what lets a paired device go on working --
# and a turn go on running -- after the window is closed.
#
# The installer rewrites this line with the installed command and the socket
# the window looks for, so both ends agree on one daemon regardless of what
# XDG_DATA_HOME happens to be in a login shell.
ExecStart=xd serve

Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
