<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="@APP_ID@" path="@SETTINGS_PATH@">

    <key name="workspaces-root" type="s">
      <default>''</default>
      <summary>Workspaces root directory</summary>
      <description>
        Directory holding the workspace tree. Empty means the default, which
        is inside the application's own data directory -- separate per build,
        so a nightly does not share a release's work.
      </description>
    </key>

    <key name="projects-root" type="s">
      <default>''</default>
      <summary>Projects root directory</summary>
      <description>
        Directory suggested first when picking a working directory or repository
        for a folder. Empty means the default, $HOME/projects.
      </description>
    </key>

    <key name="default-backend" type="s">
      <default>'claude'</default>
      <summary>Default AI backend</summary>
      <description>Backend used when no folder in the chain specifies one.</description>
    </key>

    <key name="favorite-models" type="as">
      <default>[]</default>
      <summary>Starred models</summary>
      <description>
        Models starred in the picker, as "backend/model" pairs, listed first
        when choosing which assistant answers.
      </description>
    </key>

    <key name="git-writing-backend" type="s">
      <default>''</default>
      <summary>Assistant used for Git writing</summary>
      <description>
        Backend used to draft commit and pull request text. Empty uses the
        active chat's assistant.
      </description>
    </key>

    <key name="git-writing-model" type="s">
      <default>''</default>
      <summary>Model used for Git writing</summary>
      <description>
        Model used to draft commit and pull request text. Empty uses the
        active chat's model.
      </description>
    </key>

    <key name="expanded-folders" type="as">
      <default>[]</default>
      <summary>Folders left open in the sidebar</summary>
      <description>
        Folder ids stored in the chat database that were expanded when the
        window was last used, so the tree comes back the way it was left.
      </description>
    </key>

    <key name="active-chat" type="s">
      <default>''</default>
      <summary>Chat shown when the window closed</summary>
      <description>
        The local or remote chat id that was on screen, including its location,
        so it can be selected again after the asynchronous tree loads.
      </description>
    </key>

    <key name="window-width" type="i">
      <default>1100</default>
      <summary>Window width</summary>
    </key>

    <key name="window-height" type="i">
      <default>720</default>
      <summary>Window height</summary>
    </key>

    <key name="window-maximized" type="b">
      <default>false</default>
      <summary>Window maximized state</summary>
    </key>

    <key name="terminal-visible" type="b">
      <default>false</default>
      <summary>Terminal panel shown</summary>
      <description>Whether the shell panel is open under the conversation.</description>
    </key>

    <key name="terminal-height" type="i">
      <default>260</default>
      <summary>Height of the terminal panel</summary>
      <description>How tall the shell panel was left, in pixels.</description>
    </key>

    <key name="terminal-columns" type="i">
      <default>0</default>
      <summary>Columns a terminal last had</summary>
      <description>
        Size of the last shell on screen, in character cells. A shell lays out
        its first prompt for the size it is opened at, before any resize can
        reach it, so a new one is opened at the size it is about to be given.
        Zero means none has been measured yet.
      </description>
    </key>

    <key name="terminal-rows" type="i">
      <default>0</default>
      <summary>Rows a terminal last had</summary>
    </key>

    <key name="diff-visible" type="b">
      <default>false</default>
      <summary>Changed-files pane shown</summary>
      <description>Whether the working tree's changes are shown beside the chat.</description>
    </key>

    <key name="diff-width" type="i">
      <default>420</default>
      <summary>Width of the changed-files pane</summary>
    </key>

    <key name="pane-state" type="a{su}">
      <default>{}</default>
      <summary>Open panes by chat</summary>
      <description>Per-device terminal and repository pane visibility for local and remote chats.</description>
    </key>

    <key name="sidebar-width" type="i">
      <default>280</default>
      <summary>Sidebar width</summary>
    </key>

    <key name="build-source" type="s">
      <default>''</default>
      <summary>Branch, pull request, or commit to build</summary>
      <description>Last source entered in the XD source-build panel.</description>
    </key>

  </schema>
</schemalist>
